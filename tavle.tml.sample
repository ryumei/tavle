#
#
# This config should be noted in TOML.
# See also https://github.com/toml-lang/toml

[Server]
#  Endpoint 待受ける IP
#  Port 待受けポート
Endpoint = "localhost"
Port    = 8000
#  Debug デバッグモード
Debug = true
#  EnableTLS 暗号化通信を有効にするかどうか (KeyFile と CertFile も必要)
#  KeyFile サーバ鍵
#  CertFile サーバ証明書
EnableTLS = false
CertFile = ""
KeyFile = ""
# DataDir チャット履歴の保管ディレクトリ
DataDir = "chatlog"
# Secret 暗号化キー。16 文字。
Secret = "CHANGEME"

[Notification.SlackWebhooks]
# 部屋ごとの Slack Incoming Webhook の URL。新着メッセージがあると部屋名だけを通知する。
# 書いていない部屋は通知しない。"." を含む部屋名は "test.room" のように引用符で囲む。
# foyer = "https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX"

[Log]
# AccessLog クライアントからのアクセスログ
# ServerLog サーバの動作ログ
AccessLog = "log/access.log"
ServerLog = "log/server.log"
# Level ログレベル
Level = "INFO"
